GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
PORT=3001
# Local Postgres, e.g. docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Schema for this environment (public for production, staging for staging)
DB_SCHEMA=public
